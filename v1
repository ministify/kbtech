    }

    .tc-main-header {
        margin-bottom: 30px; 
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid var(--tc-border);
        padding: 70px 5% 10px 5%; 
    }

    .tc-brand-title {
        font-size: 48px;
        font-weight: 900;
        letter-spacing: -1.5px;
        color: var(--tc-text);
        line-height: 1;
        margin: 0;
        display: flex;
        align-items: center;
    }

    #kb-typing-text::before {
        content: '\200B'; 
    }

    .tc-brand-title .cursor {
        display: inline-block;
        color: var(--tc-current-accent);
