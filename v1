        1% { transform: translate(-1px, 1px) skew(-1deg); box-shadow: -2px 0 0 var(--color-news), 2px 0 0 var(--color-reviews); }
        3% { transform: translate(1px, -1px) skew(1deg); box-shadow: 3px 0 0 var(--color-news), -3px 0 0 var(--color-reviews); }
