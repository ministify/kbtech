<script>
    (function() {
        window.addEventListener('scroll', function() {
            var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            var scrolled = 0;
            if (height > 0) {
                scrolled = (winScroll / height) * 100;
            }
            document.getElementById("scroll-progress").style.width = scrolled + "%";
        });

        const textToType = "KB Tech";
        const typeTarget = document.getElementById("kb-typing-text");
        let typeIndex = 3; 
        let isDeleting = false;
        
        function typeWriter() {
            const currentText = textToType.substring(0, typeIndex);
            typeTarget.innerHTML = currentText;

            let typeSpeed = 150; 

            if (isDeleting) {
                typeSpeed = 100; 
            }

            if (!isDeleting && typeIndex === textToType.length) {
                typeSpeed = 3000;
                isDeleting = true;
            } else if (isDeleting && typeIndex === 3) {
                isDeleting = false;
                typeSpeed = 1000;
            }

            if (isDeleting) {
                typeIndex--;
            } else {
                typeIndex++;
            }

            setTimeout(typeWriter, typeSpeed);
        }
        typeWriter();

        function updateDate() {
            var dateElement = document.getElementById('tc-live-date');
            if(dateElement) {
                var today = new Date();
                var pad = (n) => n < 10 ? '0' + n : n;
                var dateString = today.getFullYear() + "-" + 
                                 pad(today.getMonth() + 1) + "-" + 
                                 pad(today.getDate()) + " // " + 
                                 pad(today.getHours()) + ":" + 
                                 pad(today.getMinutes()) + " SYS_TIME";
                dateElement.innerHTML = dateString;
            }
        }
        updateDate();
        setInterval(updateDate, 60000); 

        var tickerHeadlines = document.querySelectorAll('.tc-ticker-item');
        var tickerIndex = 0;
        if(tickerHeadlines.length > 0) {
            setInterval(function() {
                tickerHeadlines[tickerIndex].classList.remove('active');
                tickerIndex = (tickerIndex + 1) % tickerHeadlines.length;
                tickerHeadlines[tickerIndex].classList.add('active');
            }, 3500);
        }

        var container = document.body;
        var sections = document.querySelectorAll('.tc-section-wrapper');
        
        var observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    var newColor = entry.target.getAttribute('data-color');
                    if (newColor) {
                        container.style.setProperty('--tc-current-accent', newColor);
                    }
                }
            });
        }, {
            root: null,
            rootMargin: '-40% 0px -40% 0px', 
            threshold: 0
        });

        sections.forEach(section => {
            observer.observe(section);
        });
    })();
</script>
